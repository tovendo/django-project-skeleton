DOCKER_PROJECT_NAME={{ project_name }}

DOCKER_NGINX_PORT=
DOCKER_NGINX_PORT_SSL=

DOCKER_VOLUME_APP=.
DOCKER_VOLUME_DOCKER=./docker
DOCKER_VOLUME_STATIC=./run/static
DOCKER_VOLUME_MEDIA=./run/media

DJANGO_DEBUG=True
DJANGO_HOMOLOG=True

DJANGO_ALLOWED_HOSTS=127.0.0.1

DJANGO_LOGLEVEL=info

DJANGO_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/{{ project_name }}

# separar parametros por ";"
# separar crons por "|"
# DJANGO_CRONS=
